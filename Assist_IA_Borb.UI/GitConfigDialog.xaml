<Window x:Class="Assist_IA_Borb.UI.GitConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar identidade do Git"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6FB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Antes de sincronizar, preciso saber quem é você pro Git"
                   FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Isso fica salvo globalmente no seu computador (git config --global), não precisa preencher de novo depois."
                   FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Grid.Row="2" Text="Nome" FontSize="12" Foreground="#444" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Grid.Row="3" Padding="8,6" FontSize="14" Margin="0,0,0,12" />

        <TextBlock Grid.Row="4" Text="E-mail (o mesmo do GitHub)" FontSize="12" Foreground="#444" Margin="0,0,0,4" />
        <TextBox x:Name="EmailTextBox" Grid.Row="5" Padding="8,6" FontSize="14" VerticalAlignment="Top" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="90" Height="32" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Salvar" Width="90" Height="32" Background="#4A69C9" Foreground="White"
                    BorderThickness="0" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
