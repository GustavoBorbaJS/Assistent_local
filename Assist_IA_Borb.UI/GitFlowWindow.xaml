<Window x:Class="Assist_IA_Borb.UI.GitFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git — Sincronizar projeto"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        MinHeight="400"
        Background="#F4F6FB">

    <Window.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4A69C9" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1E2233" />
            <Setter Property="Foreground" Value="#C8D3F5" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MaxHeight" Value="160" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#4A69C9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5A79D9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="#C5CCE0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">

        <!-- Cabeçalho: pasta do projeto e branch -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="ProjectPathLabel"
                           FontSize="13" FontWeight="SemiBold" Foreground="#222"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="RemoteLabel"
                           FontSize="11" Foreground="#888" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="Branch:" FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="BranchCombo" Width="120" FontSize="12"
                          SelectionChanged="BranchCombo_SelectionChanged" />
            </StackPanel>
        </Grid>

        <Separator Margin="0,10,0,0" Background="#DDE2EF" />

        <!-- Passo 1: Status -->
        <TextBlock Text="PASSO 1 — Arquivos modificados (git status)" Style="{StaticResource StepLabel}" />
        <TextBox x:Name="StatusOutput" Style="{StaticResource CodeBox}" Text="Carregando..." MinHeight="60" />

        <!-- Passo 2: Adicionar -->
        <TextBlock Text="PASSO 2 — Adicionar arquivos (git add)" Style="{StaticResource StepLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AddOutput" Grid.Column="0" Style="{StaticResource CodeBox}"
                     Text="Clique em 'Adicionar tudo' para incluir todos os arquivos acima."
                     MinHeight="36" />
            <Button x:Name="AddButton" Grid.Column="1" Content="Adicionar tudo"
                    Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                    Click="AddButton_Click" />
        </Grid>

        <!-- Passo 3: Commit -->
        <TextBlock Text="PASSO 3 — Mensagem do commit" Style="{StaticResource StepLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CommitMessageBox" Grid.Column="0"
                     Padding="8,6" FontSize="13" BorderThickness="1"
                     BorderBrush="#C5CCE0" Background="White"
                     Text="Atualização via Assist_IA_Borb" />
            <Button x:Name="CommitButton" Grid.Column="1" Content="Commitar"
                    Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                    IsEnabled="False" Click="CommitButton_Click" />
        </Grid>
        <TextBox x:Name="CommitOutput" Style="{StaticResource CodeBox}"
                 Visibility="Collapsed" Margin="0,4,0,0" />

        <!-- Passo 4: Push -->
        <TextBlock Text="PASSO 4 — Enviar para o GitHub (git push)" Style="{StaticResource StepLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PushOutput" Grid.Column="0" Style="{StaticResource CodeBox}"
                     Text="Clique em 'Enviar' para publicar o commit acima."
                     MinHeight="36" />
            <Button x:Name="PushButton" Grid.Column="1" Content="Enviar"
                    Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                    IsEnabled="False" Click="PushButton_Click" />
        </Grid>

        <!-- Rodapé -->
        <Button x:Name="CloseButton" Content="Fechar"
                HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource ActionButton}" Background="#888"
                Click="CloseButton_Click" />

    </StackPanel>
</Window>
